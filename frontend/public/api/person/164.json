  "obituaries": [
    {
      "person_id": 164,
      "id": 221,
      "deceased_name": "John Durham, one of",
      "age": "",
      "birth_date": "",
      "death_date": "1865",
      "cemetery_location": "",
      "full_text": "John Durham, one of the aged inmates of the county infirmary, died Thursday \n  morning at 6 o'clock, his death being of a nature that was very sudden. Mr. \n  Durham had been an inmate of the place for about three years and was eighty-five \n  years of age, he being one of the pioneers of this county, locating on a farm \n  in the eastern part of this county in 1865. He had been married five times, \n  the wives all being dead, except one and he was divorced from her.",
      "source_url": "https://nativeamericansofdelawarestate.com/Obituaries%20added%202016-04-03.htm"
    }
  ],
