    },
    {
      "id": 287,
      "deceased_name": "LOATMAN - On May",
      "age": "",
      "birth_date": "",
      "death_date": "",
      "cemetery_location": "Cemetery",
      "full_text": "LOATMAN - On May 25th, Sarah A. Loatman, widow of the late Simon Loatman. The \n  relatives and friends of the family are invited to attend the funeral services \n  from the parlors of A. E. Francis. Interment at Gravel Hill Cemetery, Feltonville, \n  Delaware County, Pennsylvania.",
      "source_url": "https://nativeamericansofdelawarestate.com/Obituaries%20added%202016-04-03.htm"
    },
    {
      "id": 178,
      "deceased_name": "Phyllis L. Carter",
      "age": "73",
      "birth_date": "2015",
      "death_date": "2015",
      "cemetery_location": "",
      "full_text": "Phyllis L. Carter, 73 of Dover Delaware, passed away suddenly and unexpected \n  on Monday morning February 16, 2015 at her home. Born February 16, 2015 in Greenwich, \n  NJ she was the daughter of the late Ephraim and Rebecca (nee Loatman) Mosley, \n  and the wife of the late Ralph [U.] Carter Jr., who passed in 2011.",
      "source_url": "https://nativeamericansofdelawarestate.com/Obituaries%20added%202016-04-03.htm"
    },
    {
      "id": 140,
      "deceased_name": "She is survived by",
      "age": "",
      "birth_date": "",
      "death_date": "",
      "cemetery_location": "",
      "full_text": "She is survived by one daughter, Deanna Russell and her husband Robert of Hi-Nella, \n  one son, Dean C. Swift Jr. and his wife Lynn of Millville, two grandsons, PFC \n  Michael Swift, USMC and Ryan Swift, two sisters, Marlene Lloyd and her husband \n  Karl of Stow Creek Twp. and Sherry Loatman of Hopewell Twp. , two brothers, \n  Carl B. Corney Sr. of Luray, VA and Rin els C. Corney Jr. of Laurel Lake, her \n  good friend and companion, Lenny Reichelderfer and a number of nieces, nephews \n  and cousins.",
