  "obituaries": [
    {
      "id": 124,
      "deceased_name": "He is survived by",
      "age": "",
      "birth_date": "",
      "death_date": "",
      "cemetery_location": "",
      "full_text": "He is survived by two sisters, Marion Hughes and Edna M. Loatman, both of Fairfield \n  Township; and several nieces, nephews, cousins and friends. He was predeceased \n  by five brothers, Edward and Joseph Reed and John, Frank and Ted Coker; and \n  a sister, Lethia Carter.",
      "source_url": "https://nativeamericansofdelawarestate.com/Obituaries%20added%202016-04-03.htm"
    },
    {
      "id": 72,
      "deceased_name": "In addition to his",
      "age": "",
      "birth_date": "",
      "death_date": "",
      "cemetery_location": "",
      "full_text": "In addition to his parents he was preceded in death by his sisters, Frances \n  Pritchett and Freida Reed and brothers, James Samuel Greenage and Phillip Howard \n  Greenage (infant). He is survived by his wife of 61 years, Norma Rae Carney \n  Greenage of Dover, DE; sons, Paul W. Greenage and his wife, Helene of Milford, \n  DE, Mark J. Greenage and his wife Dottie of Vero Beach, FL; sisters, Katherine \n  Clark of Oak Orchard, DE, Regina Techkerian and her husband Khaja of Philadelphia, \n  PA, Rachel Lorraine Coker and her husband Charles Edward of Dover, DE and Myrtle \n  Mosley of Columbia, MD; grandson, Michael Greenage and his wife Laura of Roanoke, \n  VA and a host of nieces and nephews.",
      "source_url": "https://nativeamericansofdelawarestate.com/Obituaries%20added%202016-04-03.htm"
    },
    {
      "id": 123,
      "deceased_name": "Robert Allen Reed 1926-2010",
      "age": "83",
      "birth_date": "1926",
      "death_date": "2010",
      "cemetery_location": "",
      "full_text": "Robert Allen Reed 1926-2010 John C. Carter notes: \"It is with sadness that I relay the passing of my granduncle Robert \"Bobby\" \n  Reed, who passed away on Saturday, Aug. 14.\" Robert Allen Reed, age 83, of Cheswold, Del., and formerly of Carmel, died Saturday, \n  Aug. 14, 2010, at Cumberland Manor in Hopewell Township.",
      "source_url": "https://nativeamericansofdelawarestate.com/Obituaries%20added%202016-04-03.htm"
    },
    {
      "id": 38,
      "deceased_name": "The husband of the",
      "age": "",
      "birth_date": "2014",
      "death_date": "1921",
      "cemetery_location": "",
      "full_text": "The husband of the late Lucy M. Dean (nee Jackson) who passed away on December \n  24, 2014, they were married for 72 years. He was born in Kent County, DE on \n  February 13, 1921 and was the son of the late Elwood and Helen Dean (nee Reed). \n  Mr. Dean lived in Hopewell Township before moving in with his son David and \n  his family in June of 2012.",
      "source_url": "https://nativeamericansofdelawarestate.com/Obituaries%20added%202016-04-03.htm"
    }
  ]
