  "obituaries": [
    {
      "id": 71,
      "deceased_name": "DOVER - Paul Joseph",
      "age": "",
      "birth_date": "2016",
      "death_date": "1933",
      "cemetery_location": "",
      "full_text": "DOVER - Paul Joseph Greenage passed away, Saturday, January 9, 2016 at home. \n Mr. Greenage was born January 19, 1933 in Dover, Delaware to the late James \n Lee Greenage and Helen Sammons Greenage.",
      "source_url": ""
    },
    {
      "id": 63,
      "deceased_name": "GREENAGE.-Died in Cheswold, Del",
      "age": "",
      "birth_date": "",
      "death_date": "1905",
      "cemetery_location": "",
      "full_text": "GREENAGE.-Died in Cheswold, Del., September 18, 1905, of consumption, Benjamin \n Greenage, aged twenty-five years. Brother Greenage accepted the truth about \n five years ago. After having run well for a little season, he fell away. But \n he made a fresh start within the last year, and died in hope, deeply regretting \n that he had not studied the word of God more faithfully. Words of comfort were \n spoken to a large audience from Hosea 13 :14. - reported by JOHN F. JONES.",
      "source_url": ""
    },
    {
      "id": 77,
      "deceased_name": "He is survived by",
      "age": "",
      "birth_date": "",
      "death_date": "",
      "cemetery_location": "",
      "full_text": "He is survived by his wife, Joanne; a daughter, Claire Marie Bennett; a son, \n William Gordon Greenage II; a brother, John Reggs Greenage of Dover; and six \n grandchildren, Jonathan Ryan Noble, Samantha Renee Greenage, Warren Keith Bennett, \n Jr., William Matthew Bennett, Thomas Robert Greenage and Michael Bannister Greenage, \n all from Preston.",
      "source_url": ""
    },
    {
      "id": 72,
      "deceased_name": "In addition to his",
      "age": "",
      "birth_date": "",
      "death_date": "",
      "cemetery_location": "",
      "full_text": "In addition to his parents he was preceded in death by his sisters, Frances \n Pritchett and Freida Reed and brothers, James Samuel Greenage and Phillip Howard \n Greenage (infant). He is survived by his wife of 61 years, Norma Rae Carney \n Greenage of Dover, DE; sons, Paul W. Greenage and his wife, Helene of Milford, \n DE, Mark J. Greenage and his wife Dottie of Vero Beach, FL; sisters, Katherine \n Clark of Oak Orchard, DE, Regina Techkerian and her husband Khaja of Philadelphia, \n PA, Rachel Lorraine Coker and her husband Charles Edward of Dover, DE and Myrtle \n Mosley of Columbia, MD; grandson, Michael Greenage and his wife Laura of Roanoke, \n VA and a host of nieces and nephews.",
      "source_url": ""
    },
